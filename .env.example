# ============================================================
# TILLU — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env with real secrets.
# See docs/ENV_SPEC.md for full documentation.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:password@localhost:5432/tillu

# --- Core API ---
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001
JWT_SECRET=change-me-in-production-use-32-chars-min
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Web Frontend (NEXT_PUBLIC = exposed to browser, safe keys only) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- AI Providers ---
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=your-cerebras-key-here
CEREBRAS_DEFAULT_MODEL=llama3.3-70b
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
HF_API_KEY=hf_your-key-here

# --- Model Router ---
MODEL_ROUTER_TIMEOUT_MS=30000
MODEL_ROUTER_MAX_RETRIES=2
MODEL_ROUTER_CIRCUIT_BREAKER_THRESHOLD=5
MODEL_ROUTER_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# --- Local Agent ---
LOCAL_AGENT_PORT=3099
LOCAL_AGENT_SECRET=change-me-local-agent-secret
LOCAL_AGENT_ALLOWED_DOMAINS=youtube.com,www.youtube.com
LOCAL_AGENT_SYNC_INTERVAL_MS=30000
LOCAL_QUEUE_PATH=./data/queue.json

# --- Agents (shared) ---
AGENT_SECRET=change-me-agent-shared-secret

# --- n8n ---
N8N_HOST=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret

# --- Sentinel ---
SENTINEL_POLL_INTERVAL_MS=60000
SENTINEL_HEARTBEAT_TIMEOUT_MS=120000
SENTINEL_TEST_INTERVAL_MS=3600000

# --- Quota Guardian ---
QUOTA_GROQ_DAILY_TOKENS=100000
QUOTA_CEREBRAS_DAILY_TOKENS=100000
QUOTA_CONSERVE_THRESHOLD=0.75
QUOTA_EMERGENCY_THRESHOLD=0.90

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=pretty
