{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm --filter @tillu/agent-sdk build && pnpm --filter @tillu/agent-research build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": { "maxDuration": 60, "memory": 1024 }
  },
  "routes": [{ "src": "/(.*)", "dest": "/api/index.ts" }]
}
