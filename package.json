{
  "name": "tillu",
  "version": "0.0.1",
  "private": true,
  "description": "Tillu — Autonomous Personal Study Environment",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "clean": "pnpm -r clean && rimraf node_modules",
    "db:migrate": "supabase db push",
    "db:seed": "node supabase/seed/run.js",
    "db:reset": "supabase db reset",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "eslint": "9.12.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "typescript": "5.6.3"
  },
  "workspaces": [
    "apps/*",
    "agents/*",
    "packages/*"
  ]
}
