{
  "name": "@tillu/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose src/**/*.spec.ts",
    "test:integration": "vitest run --reporter=verbose src/**/*.integration.spec.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "@tillu/auth": "workspace:*",
    "@tillu/database": "workspace:*",
    "@tillu/events": "workspace:*",
    "@tillu/logging": "workspace:*",
    "@tillu/schemas": "workspace:*",
    "@tillu/utilities": "workspace:*",
    "cors": "2.8.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.7.4",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.1"
  }
}
